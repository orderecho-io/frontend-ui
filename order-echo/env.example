# Server Configuration
PORT=5174
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-very-long-and-random

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# API Configuration (Frontend)
# Optional: Override the backend API URL
# If not set, frontend automatically uses:
#   - Development: http://localhost:8000
#   - Production: Same origin/hostname with port 8000
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_BASE_URL=https://api.orderecho.io (if using subdomain)
# VITE_API_BASE_URL=http://3.99.0.53:8000 (if hardcoding IP)

# Database Configuration (if you add a database later)
# DATABASE_URL=postgresql://username:password@localhost:5432/orderecho
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=orderecho
# DB_USER=username
# DB_PASSWORD=password

# Email Configuration (for password reset emails)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=noreply@orderecho.com

# Google Sheets Configuration (existing)
# GOOGLE_SHEETS_CREDENTIALS_PATH=path/to/credentials.json
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Security Configuration
# BCRYPT_ROUNDS=12
# JWT_EXPIRES_IN=7d
# PASSWORD_RESET_EXPIRES_IN=1h

# Rate Limiting
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX_REQUESTS=5
# PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
# PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3
